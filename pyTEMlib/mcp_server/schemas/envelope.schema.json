{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pycroscopy/asyncroscopy/contracts/envelope.schema.json",
  "title": "ATHENA job envelope",
  "description": "Request and response shapes for any long-running instrument or analysis job: reserve, start, status, abort, results, release. Every verb takes and returns one JSON object. Shared by asyncroscopy devices and the pyTEMlib MCP server; other instruments implement the same verbs.",
  "schema_version": "1.1.0",
  "$defs": {
    "state": {
      "enum": ["reserved", "queued", "running", "paused_awaiting_approval", "paused_suspended", "aborting", "done", "failed", "aborted", "released"]
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "violations": {
          "type": "array",
          "description": "With plan_rejected from a limit check: steps whose values fall outside the instrument's limits (the first 20).",
          "items": {
            "type": "object",
            "required": ["step", "value"],
            "properties": {
              "step": {"type": "integer", "minimum": 0},
              "device": {"type": "string"},
              "attribute": {"type": "string"},
              "value": {"type": "number"},
              "min": {"type": ["number", "null"]},
              "max": {"type": ["number", "null"]}
            }
          }
        },
        "violations_total": {"type": "integer", "minimum": 0}
      }
    },
    "reserve_request": {
      "type": "object",
      "required": ["plan"],
      "properties": {
        "plan": {"type": "object", "description": "Job-specific plan, e.g. map_plan.schema.json."},
        "caller": {"type": "string"}
      }
    },
    "reserve_response": {
      "type": "object",
      "required": ["schema_version", "reservation_id", "plan_id", "resolved_plan", "estimate"],
      "properties": {
        "schema_version": {"type": "string"},
        "reservation_id": {"type": "string"},
        "plan_id": {"type": "string"},
        "resolved_plan": {"type": "object"},
        "estimate": {
          "type": "object",
          "properties": {
            "steps": {"type": "integer", "minimum": 0},
            "duration_s": {"type": "number", "minimum": 0},
            "max_dose_e_per_a2": {"type": "number", "minimum": 0}
          }
        },
        "limits": {
          "type": "object",
          "description": "Present when the device checked its steps against limits: how many values were checked, and targets whose limits could not be read.",
          "properties": {
            "targets": {"type": "integer", "minimum": 0},
            "unchecked": {"type": "array", "items": {"type": "object", "properties": {"target": {"type": "string"}, "reason": {"type": "string"}}}}
          }
        }
      }
    },
    "start_request": {
      "type": "object",
      "required": ["reservation_id"],
      "properties": {
        "reservation_id": {"type": "string"},
        "grant_id": {"type": ["string", "null"]}
      }
    },
    "job_request": {
      "type": "object",
      "required": ["job_id"],
      "properties": {"job_id": {"type": "string"}}
    },
    "release_request": {
      "type": "object",
      "required": ["reservation_id"],
      "properties": {"reservation_id": {"type": "string"}}
    },
    "status_response": {
      "type": "object",
      "required": ["schema_version", "job_id", "state", "progress"],
      "properties": {
        "schema_version": {"type": "string"},
        "job_id": {"type": "string"},
        "reservation_id": {"type": "string"},
        "state": {"$ref": "#/$defs/state"},
        "progress": {
          "type": "object",
          "required": ["done", "total"],
          "properties": {
            "done": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0}
          }
        },
        "last_error": {"anyOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]},
        "pending_request_id": {"type": ["string", "null"]},
        "suspended": {
          "description": "While paused_suspended: why (a condition such as beam current is out of range), since when, and, once conditions are good again, seconds until it resumes.",
          "anyOf": [
            {
              "type": "object",
              "required": ["reason"],
              "properties": {
                "reason": {"type": "string"},
                "since": {"type": "number"},
                "resumes_in_s": {"type": "number", "minimum": 0}
              }
            },
            {"type": "null"}
          ]
        }
      }
    },
    "results_response": {
      "type": "object",
      "required": ["schema_version", "job_id", "state", "result_keys"],
      "properties": {
        "schema_version": {"type": "string"},
        "job_id": {"type": "string"},
        "state": {"$ref": "#/$defs/state"},
        "result_keys": {"type": "object", "description": "Named Tiled keys (or file paths without Tiled) of what the job produced."},
        "summary": {"type": "object"}
      }
    },
    "error_response": {
      "type": "object",
      "required": ["schema_version", "error"],
      "properties": {
        "schema_version": {"type": "string"},
        "error": {"$ref": "#/$defs/error"}
      }
    }
  }
}
